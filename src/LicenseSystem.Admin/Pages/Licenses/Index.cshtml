@page
@model LicenseSystem.Admin.Pages.Licenses.IndexModel
@{
    ViewData["Title"] = "Licenses Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Active Licenses</h2>
    <a class="btn btn-primary" asp-page="/Licenses/Create">+ Issue New License</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover table-striped align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>License Key</th>
                    <th>Product(s)</th>
                    <th>Type</th>
                    <th>Mode</th>
                    <th>Activations</th>
                    <th>Expires At (UTC)</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lic in Model.Licenses)
                {
                    <tr>
                        <td><span class="badge bg-light text-dark border font-monospace fs-6">@lic.LicenseKey</span></td>
                        <td>
                            @foreach (var lp in lic.LicenseProducts)
                            {
                                <span class="badge bg-primary me-1">@lp.Product.Code</span>
                            }
                        </td>
                        <td>@lic.LicenseType</td>
                        <td>
                            <span class="badge @(lic.LicenseMode == LicenseSystem.Core.Enums.LicenseMode.OnlineOnly ? "bg-warning text-dark" : "bg-info text-dark")">
                                @lic.LicenseMode
                            </span>
                        </td>
                        <td>@lic.Activations.Count(a => a.IsActive) / @lic.MaxActivations</td>
                        <td>@lic.ExpiresAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @if (lic.IsRevoked)
                            {
                                <span class="badge bg-danger">Revoked</span>
                            }
                            else if (DateTime.UtcNow >= lic.ExpiresAtUtc)
                            {
                                <span class="badge bg-secondary">Expired</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Active</span>
                            }
                        </td>
                        <td>
                            @if (!lic.IsRevoked)
                            {
                                <form method="post" asp-page-handler="Revoke" class="d-inline" onsubmit="return confirm('Are you sure you want to revoke this license?');">
                                    <input type="hidden" name="licenseId" value="@lic.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Revoke</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">@lic.RevocationReason</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
