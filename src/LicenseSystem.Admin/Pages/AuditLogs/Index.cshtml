@page
@model LicenseSystem.Admin.Pages.AuditLogs.IndexModel
@{
    ViewData["Title"] = "Security & Administrative Audit Logs";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Audit & Security Logs</h2>
    <span class="badge bg-secondary">Immutable Event Log (No Secrets Stored)</span>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover table-striped align-middle mb-0 font-monospace small">
            <thead class="table-dark">
                <tr>
                    <th>Timestamp (UTC)</th>
                    <th>Event Type</th>
                    <th>Actor</th>
                    <th>Product</th>
                    <th>License Key</th>
                    <th>IP Address</th>
                    <th>Details</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var audit in Model.Events)
                {
                    <tr>
                        <td>@audit.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td><span class="badge bg-primary">@audit.EventType</span></td>
                        <td>@audit.Actor</td>
                        <td>@(audit.ProductCode ?? "-")</td>
                        <td>@(audit.LicenseKey ?? "-")</td>
                        <td>@(audit.IpAddress ?? "-")</td>
                        <td><span class="text-muted text-break">@audit.DetailsJson</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
