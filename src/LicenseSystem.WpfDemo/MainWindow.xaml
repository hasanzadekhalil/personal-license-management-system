<Window x:Class="LicenseSystem.WpfDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personal License Management System — Desktop Client Demo"
        Height="680" Width="850" WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Status Banner -->
        <Border Grid.Row="0" Name="StatusBanner" Background="#28a745" CornerRadius="6" Padding="14" Margin="0,0,0,16">
            <StackPanel Orientation="Vertical">
                <TextBlock Name="TxtStatusTitle" Text="LICENSE ACTIVE &amp; AUTHORIZED" Foreground="White" FontSize="18" FontWeight="Bold"/>
                <TextBlock Name="TxtStatusDescription" Text="Cryptographic signature verified against server ECDSA P-256 key." Foreground="White" FontSize="13" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Hardware Fingerprint Information -->
        <GroupBox Grid.Row="1" Header="Machine Hardware Fingerprint (3-Component Salted SHA-256)" Margin="0,0,0,16" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Motherboard UUID:" FontWeight="SemiBold" Margin="0,2"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Name="TxtMotherboardId" Text="Loading..." Margin="0,2"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Processor ID:" FontWeight="SemiBold" Margin="0,2"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Name="TxtCpuId" Text="Loading..." Margin="0,2"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Primary SSD / Volume:" FontWeight="SemiBold" Margin="0,2"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Name="TxtDiskId" Text="Loading..." Margin="0,2"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Composite Hash:" FontWeight="SemiBold" Margin="0,2"/>
                <TextBox Grid.Row="3" Grid.Column="1" Name="TxtHardwareHash" IsReadOnly="True" Margin="0,2" FontFamily="Consolas"/>
            </Grid>
        </GroupBox>

        <!-- Main Work Area Tabs -->
        <TabControl Grid.Row="2">
            <!-- Online Activation Tab -->
            <TabItem Header="Online Activation">
                <StackPanel Margin="14">
                    <TextBlock Text="Enter License Key:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox Name="TxtLicenseKey" Text="LIC-SAMPLE-1234-5678" Padding="6" FontSize="14" Margin="0,0,0,10"/>
                    <Button Name="BtnActivateOnline" Content="Activate License Online" Height="36" Background="#007bff" Foreground="White" FontWeight="Bold"/>
                    <Separator Margin="0,16"/>
                    <TextBlock Text="License Details:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Name="TxtLicenseDetails" Text="Not activated yet." TextWrapping="Wrap" FontFamily="Consolas"/>
                </StackPanel>
            </TabItem>

            <!-- Tampering & Grace Simulation Tab -->
            <TabItem Header="Security &amp; Tamper Simulation">
                <StackPanel Margin="14">
                    <TextBlock Text="Simulate Failure Scenarios (Acceptance Tests AT-06, 07, 08, 11, 20):" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <WrapPanel Margin="0,0,0,10">
                        <Button Name="BtnSwapMotherboard" Content="Simulate Motherboard Replacement (AT-06)" Margin="4" Padding="8,6"/>
                        <Button Name="BtnSwapCpu" Content="Simulate CPU Replacement (AT-07)" Margin="4" Padding="8,6"/>
                        <Button Name="BtnSwapDisk" Content="Simulate Primary SSD Replacement (AT-08)" Margin="4" Padding="8,6"/>
                    </WrapPanel>

                    <WrapPanel Margin="0,0,0,10">
                        <Button Name="BtnAdvanceGraceTime" Content="Simulate 3-Hour Offline Grace (AT-11)" Margin="4" Padding="8,6"/>
                        <Button Name="BtnExpireGraceTime" Content="Simulate 7-Hour Offline (Grace Expired)" Margin="4" Padding="8,6"/>
                        <Button Name="BtnRollbackClock" Content="Simulate 5-Day Clock Rollback (AT-20)" Margin="4" Padding="8,6" Background="#dc3545" Foreground="White"/>
                    </WrapPanel>

                    <Button Name="BtnResetSimulation" Content="Reset Hardware &amp; Clocks to Original State" Margin="4" Padding="8,6"/>
                </StackPanel>
            </TabItem>

            <!-- Offline Reactivation Protocol Tab -->
            <TabItem Header="Dual Offline Reactivation (.licreq / .licresp)">
                <StackPanel Margin="14">
                    <TextBlock Text="Offline Reactivation Workflow (Air-Gapped / Hardware Replacement):" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="1. If hardware changes, generate and export an unencrypted challenge file (.licreq)." TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <Button Name="BtnExportLicReq" Content="Export Reactivation Request (.licreq)" Height="34" Margin="0,0,0,12"/>

                    <TextBlock Text="2. Transport .licreq to Admin Portal or email. Admin issues signed response (.licresp)." TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock Text="3. Import approved response to re-bind license without leaking keys (AT-21 Replay-Protected):" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <Button Name="BtnImportLicResp" Content="Import Signed Response (.licresp)" Height="34" Margin="0,0,0,12"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <TextBlock Grid.Row="3" Text="Owner-Controlled Private Licensing System • Clean Architecture • ECDSA P-256" HorizontalAlignment="Center" Foreground="#888" Margin="0,10,0,0"/>
    </Grid>
</Window>
