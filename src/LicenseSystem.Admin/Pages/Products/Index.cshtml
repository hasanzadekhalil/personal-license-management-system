@page
@model LicenseSystem.Admin.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Products Management";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Registered Products</h2>
    <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#newProductForm">
        + Add New Product
    </button>
</div>

<div class="collapse mb-4" id="newProductForm">
    <div class="card card-body shadow-sm">
        <h5 class="card-title">Register New Application / Product</h5>
        <form method="post">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Product Code (e.g. PROD-WIN-01)</label>
                    <input type="text" class="form-control" asp-for="NewProduct.Code" required />
                </div>
                <div class="col-md-5">
                    <label class="form-label">Product Name</label>
                    <input type="text" class="form-control" asp-for="NewProduct.Name" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label">VM Policy</label>
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" asp-for="NewProduct.AllowVirtualMachines" checked />
                        <label class="form-check-label">Allow Virtual Machines</label>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label">Description</label>
                    <input type="text" class="form-control" asp-for="NewProduct.Description" />
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-success">Save Product</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover table-striped align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Product Code</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Allow VMs</th>
                    <th>Created At (UTC)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var prod in Model.Products)
                {
                    <tr>
                        <td><span class="badge bg-secondary font-monospace">@prod.Code</span></td>
                        <td class="fw-bold">@prod.Name</td>
                        <td>@prod.Description</td>
                        <td>
                            @if (prod.AllowVirtualMachines)
                            {
                                <span class="badge bg-success">Permitted</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Prohibited</span>
                            }
                        </td>
                        <td>@prod.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
