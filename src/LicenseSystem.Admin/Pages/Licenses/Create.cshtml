@page
@model LicenseSystem.Admin.Pages.Licenses.CreateModel
@{
    ViewData["Title"] = "Issue License";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h4 class="mb-0">Generate & Issue New License</h4>
            </div>
            <div class="card-body p-4">
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Select Product</label>
                        <select class="form-select" asp-for="Input.ProductId" required>
                            <option value="">-- Choose Application --</option>
                            @foreach (var prod in Model.AvailableProducts)
                            {
                                <option value="@prod.Id">@prod.Name (@prod.Code)</option>
                            }
                        </select>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">License Type</label>
                            <select class="form-select" asp-for="Input.LicenseType">
                                <option value="Monthly">Monthly (Fixed 30 Days from Activation)</option>
                                <option value="Annual">Annual (Fixed 12 Months / 365 Days)</option>
                                <option value="Perpetual">Perpetual (No Expiration)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">License Policy Mode</label>
                            <select class="form-select" asp-for="Input.LicenseMode">
                                <option value="OfflineWithGrace">Offline Allowed (6-Hour Grace Period)</option>
                                <option value="OnlineOnly">Online Only (Immediate Lock on Outage)</option>
                                <option value="AirGapped">Air-Gapped (Full Offline Signed File)</option>
                            </select>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Max Devices / Activations</label>
                            <input type="number" class="form-control" asp-for="Input.MaxActivations" min="1" max="100" value="1" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Custom License Key (Leave empty to auto-generate)</label>
                            <input type="text" class="form-control font-monospace" asp-for="Input.CustomKey" placeholder="e.g. LIC-XXXX-YYYY-ZZZZ" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a class="btn btn-secondary" asp-page="/Licenses/Index">Back to List</a>
                        <button type="submit" class="btn btn-success px-4">Generate & Issue License</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
